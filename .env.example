# Copy to .env and set your keys (never commit real secrets)

# --- Story Generation (storyAI) ---
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (optional): https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: mock | openai | anthropic
# LLM_PROVIDER=mock

# --- Manga Generation (manga-ai-bot + bubble) ---
# Hugging Face token (required for API mode, and for gated local models)
# Get a free token at: https://huggingface.co/settings/tokens
HF_TOKEN=your-hugging-face-token-here

# Panel/beat extraction uses the HF Inference router first; if you hit HTTP 402
# (monthly credits exhausted), generate_manga.py falls back to OPENAI_API_KEY /
# ANTHROPIC_API_KEY via app.llm. Or skip LLM entirely: python generate_manga.py --no-llm-panels

# Image provider: api (no GPU needed) or local (needs CUDA/MPS GPU)
# IMAGE_PROVIDER=api

# Model for image generation (used by both api and local modes)
# API mode default: black-forest-labs/FLUX.1-schnell (fast, free)
# Other good options:
#   stabilityai/stable-diffusion-xl-base-1.0
#   black-forest-labs/FLUX.1-dev          (higher quality, slower)
#   stabilityai/stable-diffusion-3.5-large (local only, needs GPU)
# SD_MODEL=black-forest-labs/FLUX.1-schnell

# Device for local mode only: cuda, mps, or cpu (default: cuda)
# DEVICE=cuda
